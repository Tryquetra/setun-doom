// Physical Constraints for Sipeed Tang Nano 20K (GW2AR-LV18QN88C8/I7)
// Embedded SiP SDRAM ports (O_sdram_*, IO_sdram_dq) are bound automatically
// by nextpnr-himbaechel from the GW2AR-18C QFN88 package database.

IO_LOC  "I_clk" 4;
IO_PORT "I_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "I_btn[0]" 88;
IO_PORT "I_btn[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "I_btn[1]" 87;
IO_PORT "I_btn[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "O_led_n[0]" 15;
IO_PORT "O_led_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "O_led_n[1]" 16;
IO_PORT "O_led_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "O_led_n[2]" 17;
IO_PORT "O_led_n[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "O_led_n[3]" 18;
IO_PORT "O_led_n[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "O_led_n[4]" 19;
IO_PORT "O_led_n[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "O_led_n[5]" 20;
IO_PORT "O_led_n[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

IO_LOC  "O_uart_tx" 69;
IO_PORT "O_uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "I_uart_rx" 70;
IO_PORT "I_uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "O_flash_clk"  59;
IO_PORT "O_flash_clk"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "O_flash_cs_n" 60;
IO_PORT "O_flash_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "O_flash_mosi" 61;
IO_PORT "O_flash_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "I_flash_miso" 62;
IO_PORT "I_flash_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "O_tmds_clk_p" 33;
